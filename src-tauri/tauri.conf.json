{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBine",
  "version": "0.1.2",
  "identifier": "com.addlayer.dbine",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBine",
        "width": 1400,
        "height": 880,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Gestor de bases de datos multimotor",
    "longDescription": "DBine es un gestor de bases de datos para SQL Server, PostgreSQL, MySQL/MariaDB y SQLite: explorador de objetos, editor SQL, grilla de resultados y queries organizadas por base.",
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
