{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DBine",
  "version": "1.1.0",
  "identifier": "io.addlayer.dbine",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev --prefix ../web",
    "beforeBuildCommand": "npm run build --prefix ../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DBine",
        "width": 1400,
        "height": 880,
        "minWidth": 640,
        "minHeight": 400,
        "visible": false,
        "backgroundColor": "#1e1e1e",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "fileAssociations": [
      { "ext": ["sqlite", "sqlite3", "db3"], "name": "SQLite database", "description": "SQLite database", "role": "Editor", "rank": "Default", "mimeType": "application/vnd.sqlite3" },
      { "ext": ["db"], "name": "Database file", "description": "Database file", "role": "Editor", "rank": "Alternate" },
      { "ext": ["duckdb", "ddb"], "name": "DuckDB database", "description": "DuckDB database", "role": "Editor", "rank": "Default", "mimeType": "application/x-duckdb" },
      { "ext": ["parquet"], "name": "Parquet file", "description": "Apache Parquet file", "role": "Viewer", "rank": "Default", "mimeType": "application/vnd.apache.parquet" },
      { "ext": ["csv"], "name": "CSV file", "description": "Comma-separated values", "role": "Viewer", "rank": "Alternate", "mimeType": "text/csv", "contentTypes": ["public.comma-separated-values-text"] },
      { "ext": ["tsv"], "name": "TSV file", "description": "Tab-separated values", "role": "Viewer", "rank": "Alternate", "mimeType": "text/tab-separated-values", "contentTypes": ["public.tab-separated-values-text"] },
      { "ext": ["json"], "name": "JSON file", "description": "JSON", "role": "Viewer", "rank": "Alternate", "mimeType": "application/json", "contentTypes": ["public.json"] },
      { "ext": ["jsonl", "ndjson"], "name": "JSON Lines file", "description": "JSON Lines", "role": "Viewer", "rank": "Alternate", "mimeType": "application/x-ndjson" },
      { "ext": ["xlsx"], "name": "Excel workbook", "description": "Excel workbook", "role": "Viewer", "rank": "Alternate", "mimeType": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", "contentTypes": ["org.openxmlformats.spreadsheetml.sheet"] },
      { "ext": ["ipynb"], "name": "Jupyter Notebook", "description": "Jupyter Notebook", "role": "Viewer", "rank": "Alternate", "mimeType": "application/x-ipynb+json" }
    ],
    "shortDescription": "Gestor de bases de datos multimotor",
    "longDescription": "DBine es un gestor de bases de datos para SQL Server, PostgreSQL, MySQL/MariaDB y SQLite: explorador de objetos, editor SQL, grilla de resultados y queries organizadas por base.",
    "linux": {
      "deb": { "desktopTemplate": "linux/dbine.desktop" },
      "rpm": { "desktopTemplate": "linux/dbine.desktop" }
    },
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM2M0U0QzU3MTZBMTY2QUQKUldTdFpxRVdWMHcreGp2MWg2RDZaRVd1YXFwekNKMDdlV0VWb3JLMnZoeituaXRVdkR0andNU24K",
      "endpoints": ["https://github.com/addlayer-io/dbine/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
