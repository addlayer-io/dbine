# Maintainer: @MAINTAINER@
#
# Generated by the aur workflow of https://github.com/addlayer-io/dbine from
# packaging/aur/PKGBUILD.in; changes made here are overwritten on the next
# release.

pkgname=dbine-bin
_pkgname=dbine
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc='@SUMMARY@'
arch=('x86_64')
url='https://dbine.com'
license=('MIT')
depends=(
  'cairo'
  'dbus'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libgcc'
  'libsoup3'
  'webkit2gtk-4.1'
  'zlib'
)
optdepends=(
  'org.freedesktop.secrets: keychain (Secret Service) for the key that encrypts saved passwords'
  'git: projects and the script library'
  'unixodbc: ODBC connections'
)
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source=(@LICENSE_SOURCE@)
source_x86_64=("DBine_${pkgver}_amd64.deb::https://github.com/addlayer-io/dbine/releases/download/v${pkgver}/DBine_${pkgver}_amd64.deb")
sha256sums=(@LICENSE_SHA256@)
sha256sums_x86_64=('@DEB_SHA256@')
noextract=("DBine_${pkgver}_amd64.deb")

prepare() {
  rm -rf deb
  mkdir deb
  bsdtar -xf "DBine_${pkgver}_amd64.deb" -C deb
  bsdtar -xf deb/data.tar.* -C deb
}

package() {
  cd deb
  install -Dm755 usr/bin/dbine "$pkgdir/usr/bin/dbine"
  install -Dm644 usr/share/applications/DBine.desktop \
    "$pkgdir/usr/share/applications/dbine.desktop"

  # The bundler names the 128x128@2x icon's folder "256x256@2".
  local dir size
  for dir in usr/share/icons/hicolor/*/; do
    size=$(basename "$dir")
    size=${size%@2}
    install -Dm644 "$dir/apps/dbine.png" \
      "$pkgdir/usr/share/icons/hicolor/$size/apps/dbine.png"
  done
@LICENSE_INSTALL@
}
